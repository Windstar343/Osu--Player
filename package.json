{
  "name": "osu-player",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:lazer": "dotnet publish tools/LazerReader -c Release -o src-tauri/resources/lazer-reader",
    "desktop:dev": "npm run build:lazer && npm run dev",
    "desktop:build": "npm run build:lazer && npm run build",
    "test:ui": "npm run build && node tests/backup.cjs && node tests/features.cjs",
    "format": "prettier --write src tests vite.config.ts",
    "format:check": "prettier --check src tests vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
